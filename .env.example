PORT=3000
# Preenchida automaticamente pelo Render se você criar um banco Postgres e
# conectar a este serviço (Environment > Add Database). Não preencher à mão.
DATABASE_URL=

# Invente uma senha longa qualquer (ex.: gere em https://1password.com/password-generator/).
# Precisa ser IDÊNTICA à variável QR_SYNC_SECRET configurada no HUB TRADX.
SYNC_SECRET=
